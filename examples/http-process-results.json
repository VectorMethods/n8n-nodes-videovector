{
  "name": "VideoVector HTTP process, wait and paginated results",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "configure",
      "name": "Configure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "promptId",
              "name": "promptId",
              "value": "REPLACE_WITH_PROMPT_ID",
              "type": "string"
            },
            {
              "id": "requestKey",
              "name": "requestKey",
              "value": "={{ 'n8n:' + $execution.id + ':start-run' }}",
              "type": "string"
            },
            {
              "id": "deadline",
              "name": "deadline",
              "value": "={{ new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString() }}",
              "type": "string"
            },
            {
              "id": "indexId",
              "name": "indexId",
              "value": "",
              "type": "string"
            },
            {
              "id": "videoId",
              "name": "videoId",
              "value": "REPLACE_WITH_EXISTING_VIDEO_ID",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "start-run",
      "name": "Start Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.vectormethods.com/api/v2/workflow/process",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Configure').first().json.requestKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {prompt_id: $('Configure').first().json.promptId, video_ids: [$('Configure').first().json.videoId], ...($('Configure').first().json.indexId ? {index_id: $('Configure').first().json.indexId} : {})} }}",
        "options": {}
      }
    },
    {
      "id": "get-run",
      "name": "Get Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.vectormethods.com/api/v2/prompt-runs/' + encodeURIComponent($('Start Run').first().json.run_id) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      }
    },
    {
      "id": "run-failed?",
      "name": "Run Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Run Failed?",
              "leftValue": "={{ ['failed','cancelled'].includes($json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "run-failure",
      "name": "Run Failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1400,
        -200
      ],
      "parameters": {
        "errorMessage": "={{ 'Run ' + $('Start Run').first().json.run_id + ' ended as ' + $json.status + ': ' + JSON.stringify($json) }}"
      }
    },
    {
      "id": "run-complete?",
      "name": "Run Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Run Complete?",
              "leftValue": "={{ ['completed','completed_with_failures'].includes($json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "partial-results?",
      "name": "Partial Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        -50
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Partial Results?",
              "leftValue": "={{ $json.status === 'completed_with_failures' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "partial-completion",
      "name": "Partial Completion",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1800,
        -180
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "outcome",
              "name": "outcome",
              "value": "partial; inspect Run Failures for failed segments",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "run-deadline?",
      "name": "Run Deadline?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Run Deadline?",
              "leftValue": "={{ Date.now() >= Date.parse($('Configure').first().json.deadline) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "run-timeout",
      "name": "Run Timeout",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1800,
        100
      ],
      "parameters": {
        "errorMessage": "={{ 'Timed out waiting for run ' + $('Start Run').first().json.run_id + '. Resume with Get Run; processing continues on VideoVector.' }}"
      }
    },
    {
      "id": "wait-for-run",
      "name": "Wait for Run",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 65,
        "unit": "seconds"
      }
    },
    {
      "id": "get-results",
      "name": "Get Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.vectormethods.com/api/v2/workflow/runs/' + encodeURIComponent($('Start Run').first().json.run_id) + '/results' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "view",
              "value": "unfiltered"
            },
            {
              "name": "result_level",
              "value": "segment"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "unfiltered_cursor",
                    "value": "={{ $response.body.unfiltered?.pagination?.next_cursor || undefined }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.unfiltered?.pagination?.has_more }}",
              "limitPagesFetched": false,
              "requestInterval": 1000
            }
          }
        }
      }
    },
    {
      "id": "result-items",
      "name": "Result Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2220,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "unfiltered.data",
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure": {
      "main": [
        [
          {
            "node": "Start Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Run": {
      "main": [
        [
          {
            "node": "Get Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Results": {
      "main": [
        [
          {
            "node": "Result Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Run": {
      "main": [
        [
          {
            "node": "Run Failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Failed?": {
      "main": [
        [
          {
            "node": "Run Failure",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Run Complete?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Complete?": {
      "main": [
        [
          {
            "node": "Partial Results?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Run Deadline?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Partial Results?": {
      "main": [
        [
          {
            "node": "Partial Completion",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Partial Completion": {
      "main": [
        [
          {
            "node": "Get Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Deadline?": {
      "main": [
        [
          {
            "node": "Run Timeout",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Run": {
      "main": [
        [
          {
            "node": "Get Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 86520
  },
  "active": false,
  "pinData": {},
  "tags": []
}
