{
  "compilerOptions": {
    "strict": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "removeComments": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts", "nodes/**/*.json"]
}
